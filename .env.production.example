# Copy to .env.production and fill in real secrets before deploy.
# Never commit .env.production to version control.

# --- PostgreSQL (used by compose + backend) ---
POSTGRES_USER=gatehub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=gatehub

# --- Core application ---
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_SECRET
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-domain.example
API_URL=https://your-domain.example
NODE_ENV=production
PORT=5000

# First-time staging only — set false after bootstrap
SEED_ON_STARTUP=false

# Learning Universe publish gate (recommended true in production)
LU_REQUIRE_PDF_ON_PUBLISH=true

# Super admin bootstrap (created on first start if missing)
SUPER_ADMIN_EMAIL=superadmin@platform.local
SUPER_ADMIN_PASSWORD=CHANGE_ME_SUPER_ADMIN_PASSWORD

# --- Payments ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
EMAIL_USER=
EMAIL_PASS=

# --- AI providers (at least one required for AI features) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# AI Architect production defaults
AI_ARCHITECT_FAST_MODE=false
AI_ARCHITECT_STRICT_QA=true

# --- Banner / media integrations (optional) ---
PEXELS_API_KEY=
UNSPLASH_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Google OAuth (Coding Lab / Drive sync) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INTEGRATION_ENCRYPTION_KEY=

# --- Frontend build args (same-origin leave empty) ---
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_WS_BASE_URL=

# --- Edge proxy ---
HTTP_PORT=80
