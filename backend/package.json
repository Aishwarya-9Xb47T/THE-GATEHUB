{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"const cp=require('child_process'); const run=()=>{ const p=cp.spawn('npm', ['run', 'dev:inner'], {stdio:'inherit', shell:true}); p.on('exit', (code)=>{ if(code!==0){ console.log('Backend crashed, restarting in 3s...'); setTimeout(run, 3000); } }); }; run();\"",
    "dev:backend": "npm run dev",
    "dev:inner": "tsx watch src/index.ts",
    "build": "node scripts/ensure-pdflatex.mjs && tsc -p ../shared/lesson-body/tsconfig.json && node scripts/build.js",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "validate:startup": "tsx scripts/validate-startup.ts",
    "reset:db": "tsx src/scripts/resetDatabase.ts",
    "build-doc-index": "tsx src/scripts/build-doc-index.ts",
    "sync-docs": "tsx src/scripts/sync-docs.ts",
    "extract-routes": "tsx src/scripts/extract-platform-routes.ts",
    "docs:sync": "npm run sync-docs && npm run build-doc-index",
    "assessment:validate-domain": "tsx src/assessment-platform/scripts/validate-domain.ts",
    "validate:a0": "tsx scripts/validate-a0-critical.ts",
    "validate:a1-live": "tsx scripts/validate-a1-live-player.ts",
    "validate:a1-pat": "tsx scripts/validate-a1-pat.ts",
