    "cleanup:demo": "tsx scripts/cleanup-demo-data.ts",
    "cleanup:demo:smoke": "tsx scripts/cleanup-smoke.ts",
    "security:auth-e2e": "tsx scripts/security-auth-e2e.ts",
    "security:auth-browser": "tsx scripts/browser-auth-security-e2e.ts"
  },
