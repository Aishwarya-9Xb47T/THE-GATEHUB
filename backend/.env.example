# Database Connection
# Fresh production DB: create empty database, then:
#   npx prisma migrate deploy
#   npx prisma db seed
DATABASE_URL="postgresql://user:password@localhost:5432/the_gatehub?schema=public"

# Authentication & Security
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=

# Optional initial production accounts for a fresh database.
# Never commit real credentials. Used only by: npx prisma db seed / npm run db:seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=

SEED_INSTRUCTOR_EMAIL=
SEED_INSTRUCTOR_PASSWORD=
# SEED_INSTRUCTOR_NAME=

SEED_STUDENT_EMAIL=
SEED_STUDENT_PASSWORD=
# SEED_STUDENT_NAME=

# Server Configuration
PORT=5000
NODE_ENV=production
UPLOAD_DIR=./uploads
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000
# Public frontend origin used in emails, certificates, QR, and LaTeX video links.
# REQUIRED in production — e.g. https://thegatehub.com (CORS also allows www.thegatehub.com statically).
FRONTEND_URL=http://localhost:5173

# Email / SMTP (password reset, verification, security notices)
# Prefer SMTP_* ; EMAIL_USER/EMAIL_PASS remain supported (e.g. Gmail app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="noreply@your-domain.com"
EMAIL_FROM_NAME="THE GATEHUB"
EMAIL_USER=
EMAIL_PASS=
SUPPORT_EMAIL=support@your-domain.com

# Set true only for automated security/regression scripts in non-prod
# AUTH_RATE_LIMIT_DISABLED=false

# Allow public admin self-registration (NEVER enable in production unless intentional)
# ALLOW_ADMIN_REGISTRATION=false

# Optional LaTeX compiler paths (otherwise PATH / Program Files MiKTeX is used)
# LATEX_PDFLATEX_PATH=
# LATEX_XELATEX_PATH=
# LATEX_LUALATEX_PATH=
# LATEX_TEMP_DIR=
# LATEX_COMPILE_TIMEOUT_MS=120000

# Google OAuth — Authentication
GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_OAUTH_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# Image & Banner APIs
# BANNER_PROVIDER: pexels | unsplash | openai | auto  (default: pexels)
BANNER_PROVIDER=pexels
PEXELS_API_KEY="your-pexels-api-key"
# Unsplash public Access Key — the only Unsplash variable Banner Studio reads.
UNSPLASH_API_KEY="your-unsplash-api-key"
# Unsplash Application Secret is NOT used by Banner Studio. Do not substitute it for UNSPLASH_API_KEY.
# UNSPLASH_SECRET_KEY=

# OpenAI API Key (Assessment Generation, Document Parsing AI, AI Course Architect)
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="dall-e-3"

# AI Course Architect (Generate with AI → Academic Studio)
# Optional providers for phase routing (defaults use OpenAI when keyed):
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
# AI_ARCHITECT_MODEL=gpt-4o
# AI_ARCHITECT_FAST_MODE=false
# AI_ARCHITECT_STRICT_QA=false
# AI_ARCHITECT_COMPILE_VALIDATE=false
# AI_ARCHITECT_LESSON_CONCURRENCY=2
# AI_ARCHITECT_PUBLISH_THRESHOLD=98

# Google Workspaces & OAuth Integration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"
INTEGRATION_ENCRYPTION_KEY="your-integration-encryption-key"

# Import Engine V2 Configuration
IMPORT_ENGINE_V2=true

# Backblaze B2 (S3-compatible) — preferred object storage for new uploads.
# Optional. If unset, classroom original.pptx files are stored in Postgres (Neon).
# Configure these in Render / local .env only. Never commit real credentials.
# Bucket is private. The app stores /uploads/... paths in Neon, not public B2 URLs.
# B2_APPLICATION_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_NAME=the-gatehub-production
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
