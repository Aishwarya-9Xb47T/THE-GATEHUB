{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*", "../shared/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/scripts/**/*",
    "src/tests/**/*",
    "src/**/__tests__/**/*",
    "src/assessment-platform/scripts/**/*",
    "scripts/**/*",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
