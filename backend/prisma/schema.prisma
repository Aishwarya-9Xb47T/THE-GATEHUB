// Learning Universe Models - Code-First Learning Experience
model LearningUniverse {
  id                  String                  @id @default(cuid())
  title               String
  subtitle            String?
  description         String
  thumbnail           String?
  bannerUrl           String?                 @map("banner_url")
  bannerType          String?                 @map("banner_type")
  price               Float                   @default(0)
  categoryId          String?                 @map("category_id")
  difficulty          String                  @default("Beginner") // draft, published, archived
  status              String                  @default("draft")
  language            String                  @default("en")
  dslSource           String                  @map("dsl_source") @db.Text
  structuredData      Json                    @map("structured_data")
  sourceProjectId     String?                 @map("source_project_id")
  publishedAt         DateTime?               @map("published_at")
  currentPublishVersionId String?             @map("current_publish_version_id")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  instructorId        String                  @map("instructor_id")

  // Relations
  categoryRel         Category?               @relation(fields: [categoryId], references: [id])
  instructor          User                    @relation("InstructorLearningUniverses", fields: [instructorId], references: [id], onDelete: Cascade)
  sourceProject       LatexProject?           @relation("SourceProject", fields: [sourceProjectId], references: [id], onDelete: SetNull)
  tracks              LearningUniverseTrack[]
  enrollments         LearningUniverseEnrollment[]
  certificates        LearningUniverseCertificate[]
  assets              LearningUniverseAsset[]
  payments            Payment[]
  orders              Order[]
  product             Product?
  wishlistItems       WishlistItem[]
  publishVersions     LearningUniversePublishVersion[]
  componentSubmissions LearningUniverseComponentSubmission[]
  stepProgress        LearningUniverseStepProgress[]

  currentPublishVersion LearningUniversePublishVersion? @relation("CurrentPublishVersion", fields: [currentPublishVersionId], references: [id], onDelete: SetNull)

  @@index([instructorId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([sourceProjectId])
}

model LearningUniversePublishVersion {
  id                  String           @id @default(cuid())
  learningUniverseId  String           @map("learning_universe_id")
  versionNumber       Int              @map("version_number")
  dslSource           String           @map("dsl_source") @db.Text
  structuredData      Json             @map("structured_data")
  publishedAt         DateTime         @default(now()) @map("published_at")
  learningUniverse    LearningUniverse @relation(fields: [learningUniverseId], references: [id], onDelete: Cascade)
  currentForUniverses LearningUniverse[] @relation("CurrentPublishVersion")
  enrollments         LearningUniverseEnrollment[]

  @@unique([learningUniverseId, versionNumber])
  @@index([learningUniverseId])
}

model LearningUniverseAsset {
  id                  String                  @id @default(cuid())
  filename            String // original filename
  storedFilename      String // UUID-based filename
  mimeType            String
  size                Int
  learningUniverseId  String                  @map("learning_universe_id")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  // Relations
  learningUniverse    LearningUniverse          @relation(fields: [learningUniverseId], references: [id], onDelete: Cascade)

  @@index([learningUniverseId])
  @@unique([learningUniverseId, filename]) // unique filename per universe
}

model LearningUniverseTrack {
  id                  String                    @id @default(cuid())
  title               String
  description         String
  learningOutcomes    String?                   @map("learning_outcomes")
  careerOutcomes      String?                   @map("career_outcomes")
  difficulty          String?
  order               Int                       @default(0)
  learningUniverseId  String                    @map("learning_universe_id")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  // Relations
  learningUniverse    LearningUniverse          @relation(fields: [learningUniverseId], references: [id], onDelete: Cascade)
  modules             LearningUniverseModule[]

  @@index([learningUniverseId])
  @@index([learningUniverseId, order])
}

model LearningUniverseModule {
  id                  String                    @id @default(cuid())
  title               String
  description         String
  prerequisites       String?
  learningOutcomes    String?                   @map("learning_outcomes")
  estimatedHours      Int                       @default(0) @map("estimated_hours")
  order               Int                       @default(0)
  trackId             String                    @map("track_id")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  // Relations
