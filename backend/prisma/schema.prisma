  versions               QuizVersion[]

  @@index([id])
  @@index([authorId])
  @@index([archivedAt])
  @@index([visibility])
}

model QuizVersion {
  id          String   @id @default(cuid())
  quizId      String   @map("quiz_id")
  version     Int
  snapshot    Json
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, version])
  @@index([quizId])
}

model Question {
  id             String   @id @default(cuid())
  text           String
  type           String
  difficulty     String?
  points         Int?
  marks          Int      @default(1)
  order          Int      @default(0)
  explanation    String?
  metadata       Json     @default("{}")
  quizId         String   @map("quiz_id")
  bankQuestionId String?  @unique @map("bank_question_id")
