// ─── Live Classroom System ───────────────────────────────────────────────────

model LiveSession {
  id                   String    @id @default(cuid())
  roomCode             String?   @unique @map("room_code")
  pin                  String?   @map("pin")
  title                String
  status               String    @default("lobby")
  sessionType          String    @default("live_classroom") @map("session_type")
  sourceType           String    @default("existing_quiz") @map("source_type")
  quizId               String    @map("quiz_id")
  hostUserId           String    @map("host_user_id")
  courseId             String?   @map("course_id")
  lectureId            String?   @map("lecture_id")
  learningUniverseId   String?   @map("learning_universe_id")
  settings             Json      @default("{}")
  scheduledAt          DateTime? @map("scheduled_at")
  clonedFromId         String?   @map("cloned_from_id")
  currentQuestionIndex Int       @default(-1) @map("current_question_index")
  questionStartedAt    DateTime? @map("question_started_at")
  startedAt            DateTime? @map("started_at")
  endedAt              DateTime? @map("ended_at")
  maxParticipants      Int       @default(250) @map("max_participants")
  cameraEnabled        Boolean   @default(false) @map("camera_enabled")
  chatEnabled          Boolean   @default(true) @map("chat_enabled")
  isLocked             Boolean   @default(false) @map("is_locked")
  isPaused             Boolean   @default(false) @map("is_paused")
  leaderboardHidden    Boolean   @default(false) @map("leaderboard_hidden")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  quiz         Quiz                  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  host         User                  @relation("LiveSessionHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  course       Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  participants LiveParticipant[]
  answers      LiveAnswer[]
  snapshots    LeaderboardSnapshot[]
  analytics    SessionAnalytics?
  events       LiveSessionEvent[]

  @@index([roomCode])
  @@index([hostUserId])
  @@index([quizId])
  @@index([status])
  @@index([courseId])
}

model LiveParticipant {
  id            String   @id @default(cuid())
  sessionId     String   @map("session_id")
  userId        String?  @map("user_id")
  displayName   String   @map("display_name")
  avatar        String?
  teamId        String?  @map("team_id")
  status        String   @default("online")
  score         Float    @default(0)
  xp            Int      @default(0)
  streak        Int      @default(0)
  correctCount  Int      @default(0) @map("correct_count")
  wrongCount    Int      @default(0) @map("wrong_count")
  rank          Int?
  joinedAt      DateTime @default(now()) @map("joined_at")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")
  quizAttemptId String?  @map("quiz_attempt_id")
  currentQuestionIndex Int       @default(-1) @map("current_question_index")
  questionStartedAt    DateTime? @map("question_started_at")
  avatarCategory String?  @map("avatar_category")
  accuracy       Float    @default(0)
  currentStreak  Int      @default(0) @map("current_streak")
  answerSpeed    Float    @default(0) @map("answer_speed")
  prevRank       Int?     @map("prev_rank")
  rankChange     Int      @default(0) @map("rank_change")
  cameraOn       Boolean  @default(false) @map("camera_on")
  micOn          Boolean  @default(false) @map("mic_on")
  raisedHand     Boolean  @default(false) @map("raised_hand")
  networkStatus  String   @default("good") @map("network_status")
  device         String?  @map("device")
  joinTime       DateTime @default(now()) @map("join_time")
  leaveTime      DateTime? @map("leave_time")
  finishedAt           DateTime? @map("finished_at")
  batteryStatus  String?   @map("battery_status")
  browser        String?   @map("browser")
  tabFocused     Boolean   @default(true) @map("tab_focused")
  fullscreen     Boolean   @default(false) @map("fullscreen")
  violationCount Int       @default(0) @map("violation_count")
  lives          Int       @default(3) @map("lives")
  coins          Int       @default(0) @map("coins")
  powerups       Json      @default("[]") @map("powerups")

  session LiveSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers LiveAnswer[]

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@index([sessionId, score])
}

model LiveAnswer {
  id               String   @id @default(cuid())
  sessionId        String   @map("session_id")
  participantId    String   @map("participant_id")
  questionId       String   @map("question_id")
  answer           Json
  isCorrect        Boolean  @default(false) @map("is_correct")
  pointsEarned     Float    @default(0) @map("points_earned")
  responseTimeMs   Int?     @map("response_time_ms")
  marksEarned      Float    @default(0) @map("marks_earned")
  xpEarned         Int      @default(0) @map("xp_earned")
  streakAt         Int      @default(0) @map("streak_at")
  isFirstCorrect   Boolean  @default(false) @map("is_first_correct")
  isLastCorrect    Boolean  @default(false) @map("is_last_correct")
  answeredAt       DateTime @default(now()) @map("answered_at")
  /// Immutable question/options content at answer time (historical report integrity)
  questionSnapshot Json?    @map("question_snapshot")

  session     LiveSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant LiveParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question    Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantId, questionId])
  @@index([sessionId])
  @@index([questionId])
}

model LeaderboardSnapshot {
  id            String   @id @default(cuid())
  sessionId     String   @map("session_id")
  questionIndex Int      @map("question_index")
  rankings      Json
  createdAt     DateTime @default(now()) @map("created_at")

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, questionIndex])
}

model SessionAnalytics {
  id                  String   @id @default(cuid())
  sessionId           String   @unique @map("session_id")
  totalParticipants   Int      @default(0) @map("total_participants")
  avgAccuracy         Float    @default(0) @map("avg_accuracy")
  avgResponseTimeMs   Int?     @map("avg_response_time_ms")
  questionStats       Json     @default("[]") @map("question_stats")
  dropOffData         Json     @default("[]") @map("drop_off_data")
  heatmapData         Json     @default("{}") @map("heatmap_data")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model LiveSessionEvent {
  id            String   @id @default(cuid())
  sessionId     String   @map("session_id")
  participantId String?  @map("participant_id")
  eventType     String   @map("event_type")
  timestamp     DateTime @default(now()) @map("timestamp")
  payload       Json     @default("{}") @map("payload")

  session       LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
  @@index([timestamp])
}

model QuizRoomTemplate {
  id          String   @id @default(cuid())
  hostUserId  String   @map("host_user_id")
  name        String
  description String?
  sessionType String   @default("live_classroom") @map("session_type")
  sourceType  String   @default("existing_quiz") @map("source_type")
  settings    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
