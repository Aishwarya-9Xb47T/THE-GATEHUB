  notes              String?      @db.Text
  dslSnapshot        String       @map("dsl_snapshot") @db.Text
  fileInventory      Json?        @map("file_inventory")
  assetInventory     Json?        @map("asset_inventory")
  projectMetadata    Json?        @map("project_metadata")
  learningUniverseId String?      @map("learning_universe_id")
  resourceCourseId   String?      @map("resource_course_id")
