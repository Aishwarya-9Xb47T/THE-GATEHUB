generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                  @id @default(cuid())
  email               String                  @unique
  passwordHash        String?                 @map("password_hash")
  googleId            String?                 @unique @map("google_id")
  authProvider        String                  @default("local") @map("auth_provider")
  firstName           String                  @map("first_name")
  lastName            String                  @map("last_name")
  avatar              String?
  profileImage        String?                 @map("profile_image")
  role                String                  @default("student")
  suspended           Boolean                 @default(false)
  deletedAt           DateTime?               @map("deleted_at")
  loginAttempts       Int                     @default(0) @map("login_attempts")
  lockedUntil         DateTime?               @map("locked_until")
  lastLoginAt         DateTime?               @map("last_login_at")
  phone               String?
  designation         String?
  bio                 String?                 @db.Text
  contactEmail        String?                 @map("contact_email")
  tokenVersion        Int                     @default(0) @map("token_version")
  emailVerified       Boolean                 @default(false) @map("email_verified")
  emailVerifiedAt     DateTime?               @map("email_verified_at")
  pendingEmail        String?                 @map("pending_email")
  emailNotifications  Boolean                 @default(true) @map("email_notifications")
  googleAccessToken   String?                 @map("google_access_token")
  googleRefreshToken  String?                 @map("google_refresh_token")
  googleTokenExpiry   DateTime?               @map("google_token_expiry")
  googleEmail         String?                 @map("google_email")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  authTokens          AuthToken[]
  securityAuditLogs   SecurityAuditLog[]
  certificates        Certificate[]
  coursesCreated      Course[]                @relation("InstructorCourses")
  enrollments         Enrollment[]
  latexCollaborations LatexCollaborator[]
  latexProjects       LatexProject[]          @relation("ProjectOwner")
  payments            Payment[]
  orders              Order[]
  invoices            Invoice[]
  cart                Cart?
  payoutProfile       InstructorPayoutProfile?
  payoutWithdrawals   PayoutWithdrawal[]
  refundRequests      RefundRequest[]
  referralCodes       ReferralCode[]
  referralsMade       Referral[]           @relation("Referrer")
  referralsReceived   Referral[]           @relation("Referred")
  giftPurchasesSent   GiftPurchase[]       @relation("GiftSender")
  giftPurchasesRecv   GiftPurchase[]       @relation("GiftRecipient")
  quizAttempts        QuizAttempt[]
  notes               StudentNote[]
  latexDocuments      LatexDocument[]
  wishlist            WishlistItem[]
  reviews             Review[]
  resourceCourses     ResourceCourse[]        @relation("ResourceCourses")
  // Learning Universe relations
  learningUniverses   LearningUniverse[]      @relation("InstructorLearningUniverses")
  luEnrollments       LearningUniverseEnrollment[]
  luCertificates      LearningUniverseCertificate[]
  luProjectSubmissions LearningUniverseProjectSubmission[]
  luComponentSubmissions LearningUniverseComponentSubmission[]
  notifications       Notification[]
  projectReviewsGiven LearningUniverseProjectSubmission[] @relation("ProjectReviewer")
  componentReviewsGiven LearningUniverseComponentSubmission[] @relation("ComponentSubmissionReviewer")
  latexProjectVersions LatexProjectVersion[]
  latexProjectTimelineEvents LatexProjectTimelineEvent[]
  adminAuditLogs      AdminAuditLog[]         @relation("AuditActor")
  sessions            UserSession[]
  loginHistory        LoginHistory[]
  integrations        UserIntegration[]
  workspaceSnapshots  StudentWorkspaceSnapshot[]
  luStepProgress      LearningUniverseStepProgress[]
  liveSessionsHosted  LiveSession[]                @relation("LiveSessionHost")
  liveParticipations  LiveParticipant[]
  quizRoomTemplates   QuizRoomTemplate[]
  quizRoomPreferences QuizRoomPreferences?
  quizLibraryTemplates QuizLibraryTemplate[] @relation("QuizLibraryTemplateAuthor")
  quizLibraryTemplateFavorites QuizLibraryTemplateFavorite[]
  quizLibraryTemplateUsages QuizLibraryTemplateUsage[]
  bankQuestions       BankQuestion[]           @relation("BankQuestionAuthor")
  bankCollections     BankQuestionCollection[]   @relation("BankCollectionAuthor")
  bankQuestionReviews BankQuestionReview[]       @relation("BankQuestionReviewer")
  bankImportJobs      BankQuestionImportJob[]    @relation("BankImportJobAuthor")
  authoredQuizzes     Quiz[]                     @relation("QuizAuthor")
  // Universal Assessment Platform
  assessmentsAuthored     Assessment[]           @relation("AssessmentAuthor")
  assessmentVersionsCreated AssessmentVersion[]  @relation("AssessmentVersionCreator")
  questionsAuthored       AssessQuestion[]             @relation("QuestionAuthor")
  questionVersionsCreated AssessQuestionVersion[]      @relation("QuestionVersionCreator")
  questionCollections     AssessQuestionCollection[]   @relation("QuestionCollectionAuthor")
  assessmentDeploymentsHosted AssessmentDeployment[] @relation("DeploymentHost")
  assessmentAttempts      AssessmentAttempt[]
  organizationMemberships OrganizationMember[]
  mediaAssetsUploaded     MediaAsset[]           @relation("MediaUploader")
  xpTransactions          XPTransaction[]
  coinTransactions        CoinTransaction[]
  badgeAwards             BadgeAward[]
  achievements            Achievement[]
  gamificationProfile     UserGamificationProfile?
  platformAnalyticsEvents PlatformAnalyticsEvent[] @relation("AnalyticsActor")
  aiHistories             AIHistory[]
  platformAuditLogs       PlatformAuditLog[]     @relation("PlatformAuditActor")
  musicTracks             MusicTrack[]
  presentationsCreated    Presentation[]        @relation("PresentationAuthor")
  classroomSessionsHosted ClassroomSession[]    @relation("ClassroomSessionHost")
  classroomParticipations ClassroomParticipant[]
  studentQuestions          StudentQuestion[]
  studentChatMessages       StudentChatMessage[]

  @@index([email])
  @@index([role])
  @@index([deletedAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String   @map("admin_id")
  action      String
  targetId    String?  @map("target_id")
  targetType  String?  @map("target_type")
  details     Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  admin       User     @relation("AuditActor", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([targetId])
  @@index([createdAt])
}

model PlatformSettings {
  id                      String   @id @default("platform")
  platformName            String   @default("THE GATEHUB") @map("platform_name")
  platformLogo            String?  @map("platform_logo")
  faviconUrl              String?  @map("favicon_url")
  contactEmail            String?  @map("contact_email")
  supportEmail            String?  @map("support_email")
  supportPhone            String?  @map("support_phone")
  websiteUrl              String?  @map("website_url")
  companyName             String?  @map("company_name")
  companyGstin            String?  @map("company_gstin")
  companyAddress          String?  @map("company_address") @db.Text
  footerText              String?  @map("footer_text")
  maintenanceMode         Boolean  @default(false) @map("maintenance_mode")
  defaultCurrency         String   @default("INR") @map("default_currency")
  platformFeePercentage   Float    @default(20) @map("platform_fee_percentage")
  instructorSharePercentage Float @default(80) @map("instructor_share_percentage")
  commerceGstPercentage   Float    @default(0) @map("commerce_gst_percentage")
  certificateIssuerName   String?  @map("certificate_issuer_name")
  certificateDesignation  String?  @map("certificate_designation")
  certificatePrefix       String?  @map("certificate_prefix")
  certificateSignatureUrl String?  @map("certificate_signature_url")
  certificateSealUrl      String?  @map("certificate_seal_url")
  certificateBackgroundUrl String? @map("certificate_background_url")
  paymentGateway          String   @default("razorpay") @map("payment_gateway")
  aiAuthoringEnabled      Boolean  @default(true) @map("ai_authoring_enabled")
  aiModelName             String?  @map("ai_model_name")
  aiProvider              String   @default("openai") @map("ai_provider")
  aiLuBuilderEnabled      Boolean  @default(true) @map("ai_lu_builder_enabled")
  aiTutorEnabled          Boolean  @default(false) @map("ai_tutor_enabled")
  aiQuizGeneratorEnabled  Boolean  @default(true) @map("ai_quiz_generator_enabled")
  aiProjectEvaluatorEnabled Boolean @default(false) @map("ai_project_evaluator_enabled")
  aiInterviewAssistantEnabled Boolean @default(false) @map("ai_interview_assistant_enabled")
  studentRegistrationEnabled Boolean @default(true) @map("student_registration_enabled")
  instructorRegistrationEnabled Boolean @default(true) @map("instructor_registration_enabled")
  instructorAutoApprove   Boolean  @default(true) @map("instructor_auto_approve")
  emailVerificationEnabled Boolean @default(false) @map("email_verification_enabled")
  adminCreationEnabled    Boolean  @default(false) @map("admin_creation_enabled")
  luPublishingEnabled     Boolean  @default(true) @map("lu_publishing_enabled")
  luRequireReview         Boolean  @default(false) @map("lu_require_review")
  luAllowPublic           Boolean  @default(true) @map("lu_allow_public")
  luRequireEnrollment     Boolean  @default(true) @map("lu_require_enrollment")
  luRequirePayment        Boolean  @default(true) @map("lu_require_payment")
  luAllowProjectSubmissions Boolean @default(true) @map("lu_allow_project_submissions")
  luAllowResubmissions    Boolean  @default(true) @map("lu_allow_resubmissions")
  luEnableAutoGrading     Boolean  @default(false) @map("lu_enable_auto_grading")
  sessionTimeoutMinutes   Int      @default(1440) @map("session_timeout_minutes")
  jwtExpiryHours          Int      @default(168) @map("jwt_expiry_hours")
  maxLoginAttempts        Int      @default(5) @map("max_login_attempts")
  passwordMinLength       Int      @default(8) @map("password_min_length")
  requirePasswordNumber   Boolean  @default(true) @map("require_password_number")
  requirePasswordSpecial  Boolean  @default(true) @map("require_password_special")
  rateLimitingEnabled     Boolean  @default(true) @map("rate_limiting_enabled")
  captchaEnabled          Boolean  @default(false) @map("captcha_enabled")
  smtpHost                String?  @map("smtp_host")
  smtpPort                Int?     @map("smtp_port")
  smtpUsername            String?  @map("smtp_username")
  smtpPassword            String?  @map("smtp_password")
  emailTemplates          Json?    @map("email_templates")
  updatedAt               DateTime @updatedAt @map("updated_at")
  updatedById             String?  @map("updated_by_id")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  tokenVersion Int      @map("token_version")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent") @db.Text
  lastActive   DateTime @default(now()) @map("last_active")
  createdAt    DateTime @default(now()) @map("created_at")
  revoked      Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revoked])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  success   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

/// One-time auth tokens (email verify, password reset, email change, OAuth exchange).
/// Raw tokens are NEVER stored — only SHA-256 hashes.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  tokenHash String    @unique @map("token_hash")
  payload   Json?
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@index([type, usedAt])
}

/// Security-sensitive events (no passwords/tokens/secrets in meta).
model SecurityAuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  email     String?
  action    String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([email, createdAt])
}

model AiUsageLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  feature   String
  tokens    Int?
  cost      Float?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([feature])
}

model LatexDocument {
  id        String   @id @default(uuid())
  title     String
  content   String
  pdfUrl    String?  @map("pdf_url")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
}

model Category {
  id                  String                  @id @default(cuid())
  name                String                  @unique
  slug                String                  @unique
  description         String?
  image               String?
  groupName           String?                 @map("group_name") // e.g., "Development", "Data Science"
  icon                String? // Lucide icon name or emoji
  parentId            String?                 @map("parent_id")
  parent              Category?               @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  subcategories       Category[]              @relation("CategoryToSubcategory")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  courses             Course[]
  learningUniverses   LearningUniverse[]

  @@index([slug])
  @@index([groupName])
}

model Course {
  id            String         @id @default(cuid())
  title         String
  subtitle      String?
  description   String?
  price         Float          @default(0)
  thumbnail     String?
  bannerUrl     String?        @map("banner_url")
  bannerType    String?        @map("banner_type")
  difficulty    String?
  language      String         @default("en")
  status        String         @default("draft")
  averageRating Float          @default(0) @map("average_rating")
  reviewCount   Int            @default(0) @map("review_count")
  publishedAt   DateTime?      @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  instructorId  String         @map("instructor_id")
  category      String?
  subcategory   String?
  categoryId    String?        @map("category_id")
  subcategoryId String?        @map("subcategory_id")
  aiLandingData String?        @map("ai_landing_data")
  aiContent     String?        @map("ai_content") // New JSON field for Udemy-style details
  certificates  Certificate[]
  categoryRel   Category?      @relation(fields: [categoryId], references: [id])
  instructor    User           @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]
  payments      Payment[]
  orders        Order[]
  product       Product?
  sections      Section[]
  wishlist      WishlistItem[]
  reviews       Review[]
  liveSessions  LiveSession[]
  bankQuestions BankQuestion[]
  presentations Presentation[]

  @@index([instructorId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@index([createdAt])
}

model Order {
  id                 String            @id @default(cuid())
  orderNumber        String            @unique @map("order_number")
  userId             String            @map("user_id")
  courseId           String?           @map("course_id")
  learningUniverseId String?           @map("learning_universe_id")
  productType        String            @map("product_type")
  productTitle       String            @map("product_title")
  instructorId       String?           @map("instructor_id")
  subtotal           Float
  discountAmount     Float             @default(0) @map("discount_amount")
  taxAmount          Float             @default(0) @map("tax_amount")
  totalAmount        Float             @map("total_amount")
  currency           String            @default("INR")
  couponCode         String?           @map("coupon_code")
  status             String            @default("pending")
  razorpayOrderId    String?           @unique @map("razorpay_order_id")
  orderKind          String            @default("single") @map("order_kind")
  bundleId           String?           @map("bundle_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course             Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  learningUniverse   LearningUniverse? @relation(fields: [learningUniverseId], references: [id], onDelete: SetNull)
  payment            Payment?
  invoice            Invoice?
  items              OrderItem[]
  refundRequests     RefundRequest[]

  @@index([userId])
  @@index([courseId])
  @@index([learningUniverseId])
  @@index([status])
  @@index([createdAt])
}

model Coupon {
  id                 String    @id @default(cuid())
  code               String    @unique
  description        String?
  discountType       String    @map("discount_type")
  discountValue      Float     @map("discount_value")
  maxUses            Int?      @map("max_uses")
  usedCount          Int       @default(0) @map("used_count")
  minOrderAmount     Float     @default(0) @map("min_order_amount")
  expiresAt          DateTime? @map("expires_at")
  active             Boolean   @default(true)
  courseId           String?   @map("course_id")
  learningUniverseId String?   @map("learning_universe_id")
  productType        String?   @map("product_type")
  firstPurchaseOnly  Boolean   @default(false) @map("first_purchase_only")
  maxDiscount        Float?    @map("max_discount")
  categoryId         String?   @map("category_id")
  globalScope        Boolean   @default(false) @map("global_scope")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([active])
  @@index([expiresAt])
}

model Invoice {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique @map("invoice_number")
  orderId        String   @unique @map("order_id")
  userId         String   @map("user_id")
  paymentId      String?  @unique @map("payment_id")
  subtotal       Float
  discountAmount Float    @default(0) @map("discount_amount")
  taxAmount      Float    @default(0) @map("tax_amount")
  totalAmount    Float    @map("total_amount")
  currency       String   @default("INR")
  billingName    String?  @map("billing_name")
  billingEmail   String?  @map("billing_email")
  billingAddress String?  @map("billing_address") @db.Text
  gstin          String?
  cgstAmount     Float?   @default(0) @map("cgst_amount")
  sgstAmount     Float?   @default(0) @map("sgst_amount")
  igstAmount     Float?   @default(0) @map("igst_amount")
  hsnSac         String?  @default("999293") @map("hsn_sac")
  lineItems      Json     @map("line_items")
  pdfPath        String?  @map("pdf_path")
  issuedAt       DateTime @default(now()) @map("issued_at")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment        Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([issuedAt])
}

model Payment {
  id                 String            @id @default(cuid())
  amount             Float
  currency           String            @default("INR")
  status             String            @default("pending")
  transactionId      String?           @unique @map("transaction_id")
  userId             String            @map("user_id")
  orderId            String?           @unique @map("order_id")
  courseId           String?           @map("course_id")
  learningUniverseId String?           @map("learning_universe_id")
  productType        String            @default("course") @map("product_type")
  gateway            String            @default("razorpay")
  razorpayOrderId    String?           @unique @map("razorpay_order_id")
  instructorId       String?           @map("instructor_id")
  platformFee        Float?            @map("platform_fee")
  instructorEarning  Float?            @map("instructor_earning")
  subtotal           Float?
  discountAmount     Float?            @default(0) @map("discount_amount")
  taxAmount          Float?            @default(0) @map("tax_amount")
  couponCode         String?           @map("coupon_code")
  refundAmount       Float?            @map("refund_amount")
  refundedAt         DateTime?         @map("refunded_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  order              Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  course             Course?           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learningUniverse   LearningUniverse? @relation(fields: [learningUniverseId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice            Invoice?

  @@index([userId])
  @@index([courseId])
  @@index([learningUniverseId])
  @@index([instructorId])
  @@index([transactionId])
  @@index([productType])
  @@index([status])
}

model Product {
  id                 String            @id @default(cuid())
  productType        String            @map("product_type")
  slug               String            @unique
  displayName        String            @map("display_name")
  description        String?           @db.Text
  thumbnail          String?
  banner             String?
  instructorId       String?           @map("instructor_id")
  categoryId         String?           @map("category_id")
  courseId           String?           @unique @map("course_id")
  learningUniverseId String?           @unique @map("learning_universe_id")
  bundleId           String?           @unique @map("bundle_id")
  price              Float             @default(0)
  discountPrice      Float?            @map("discount_price")
  currency           String            @default("INR")
  taxRate            Float             @default(0) @map("tax_rate")
  visible            Boolean           @default(true)
  published          Boolean           @default(false)
  featured           Boolean           @default(false)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  course             Course?           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learningUniverse   LearningUniverse? @relation(fields: [learningUniverseId], references: [id], onDelete: Cascade)
  bundle             ProductBundle?    @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  wishlistItems      WishlistItem[]

  @@index([productType])
  @@index([published, visible])
  @@index([instructorId])
  @@index([categoryId])
  @@index([featured])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
}

model OrderItem {
  id                 String            @id @default(cuid())
  orderId            String            @map("order_id")
  productId          String?           @map("product_id")
  productType        String            @map("product_type")
  productTitle       String            @map("product_title")
  courseId           String?           @map("course_id")
  learningUniverseId String?           @map("learning_universe_id")
  unitPrice          Float             @map("unit_price")
  quantity           Int               @default(1)
  lineTotal          Float             @map("line_total")
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model RefundRequest {
  id          String    @id @default(cuid())
  paymentId   String    @map("payment_id")
  orderId     String?   @map("order_id")
  userId      String    @map("user_id")
  amount      Float
  reason      String    @db.Text
  status      String    @default("pending")
  adminNote   String?   @map("admin_note") @db.Text
  gatewayRef  String?   @map("gateway_ref")
  processedBy String?   @map("processed_by")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([paymentId])
}

