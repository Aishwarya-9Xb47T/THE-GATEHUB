model LatexProject {
  id            String              @id @default(cuid())
  title         String
  ownerId       String              @map("owner_id")
  lectureId     String?             @unique @map("lecture_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  collaborators LatexCollaborator[]
  files         LatexFile[]
  versions      LatexProjectVersion[]
  timelineEvents LatexProjectTimelineEvent[]
  learningUniverses LearningUniverse[] @relation("SourceProject")
  lecture       Lecture?            @relation(fields: [lectureId], references: [id])
  owner         User                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model LatexProjectVersion {
  id                 String       @id @default(cuid())
  projectId          String       @map("project_id")
