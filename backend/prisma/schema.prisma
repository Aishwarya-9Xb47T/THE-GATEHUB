// ─── Assessment Studio / Enterprise Question Bank ───────────────────────────

model BankQuestion {
  id                   String   @id @default(cuid())
  authorId             String   @map("author_id")
  stem                 String   @db.Text
  type                 String
  difficulty           String?
  bloomLevel           String?  @map("bloom_level")
  status               String   @default("draft")
  source               String   @default("manual")
  language             String   @default("en")
  topic                String?
  subtopic             String?
  explanation          String?  @db.Text
  hints                Json     @default("[]")
  metadata             Json     @default("{}")
  tags                 Json     @default("[]")
  references           Json     @default("[]")
  aiConfidence         Float?   @map("ai_confidence")
  estimatedSeconds     Int?     @map("estimated_seconds")
  version              Int      @default(1)
  courseId             String?  @map("course_id")
  learningUniverseId   String?  @map("learning_universe_id")
  legacyQuestionId     String?  @unique @map("legacy_question_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  author         User                      @relation("BankQuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  course         Course?                   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  options        BankQuestionOption[]
  versions       BankQuestionVersion[]
  collectionItems BankQuestionCollectionItem[]
  analytics      BankQuestionAnalytics?
  reviews        BankQuestionReview[]
  validations    BankQuestionAIValidation[]
  legacyQuestion   Question? @relation("MigratedFromQuestion", fields: [legacyQuestionId], references: [id], onDelete: SetNull)
  materializedIn   Question? @relation("MaterializedQuestion")

  @@index([authorId])
  @@index([status])
  @@index([type])
  @@index([difficulty])
  @@index([bloomLevel])
  @@index([courseId])
  @@index([source])
  @@index([createdAt])
}

model BankQuestionOption {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  text       String   @db.Text
  isCorrect  Boolean  @default(false) @map("is_correct")
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model BankQuestionVersion {
  id          String   @id @default(cuid())
  questionId  String   @map("question_id")
  version     Int
  snapshot    Json
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, version])
  @@index([questionId])
}

model BankQuestionCollection {
  id          String   @id @default(cuid())
  authorId    String   @map("author_id")
  name        String
  description String?
  kind        String   @default("folder")
  visibility  String   @default("private")
  smartRules  Json?    @map("smart_rules")
  isTemplate  Boolean  @default(false) @map("is_template")
  templateType String? @map("template_type")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  author User                         @relation("BankCollectionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  items  BankQuestionCollectionItem[]

  @@index([authorId])
  @@index([kind])
  @@index([visibility])
}

model BankQuestionCollectionItem {
  id           String   @id @default(cuid())
  collectionId String   @map("collection_id")
  questionId   String   @map("question_id")
  order        Int      @default(0)
  addedAt      DateTime @default(now()) @map("added_at")

  collection BankQuestionCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  question   BankQuestion           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, questionId])
  @@index([collectionId])
  @@index([questionId])
}

model BankQuestionAnalytics {
  id              String   @id @default(cuid())
  questionId      String   @unique @map("question_id")
  timesUsed       Int      @default(0) @map("times_used")
  attempts        Int      @default(0)
  avgAccuracy     Float    @default(0) @map("avg_accuracy")
  avgTimeMs       Int?     @map("avg_time_ms")
  confusionScore  Float?   @map("confusion_score")
  difficultyDrift Float?   @map("difficulty_drift")
  updatedAt       DateTime @updatedAt @map("updated_at")

  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model BankQuestionReview {
  id          String   @id @default(cuid())
  questionId  String   @map("question_id")
  reviewerId  String?  @map("reviewer_id")
  status      String
  comment     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reviewer User?        @relation("BankQuestionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([questionId])
  @@index([status])
}

model BankQuestionAIValidation {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  status     String   @default("pending")
  checks     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([status])
}

model BankQuestionImportJob {
  id        String   @id @default(cuid())
  authorId  String   @map("author_id")
  source    String
  status    String   @default("processing")
  fileName  String?  @map("file_name")
  sourceUrl String?  @map("source_url")
  preview   Json?
  error     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author User @relation("BankImportJobAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([status])
  @@index([source])
}

// ═══════════════════════════════════════════════════════════════════════════
// UNIVERSAL ASSESSMENT PLATFORM
// @see docs/ASSESSMENT-PLATFORM-ARCHITECTURE.md
// Legacy bridges: legacyQuizId, legacySessionId, legacyBankId, legacyQuizQId
// ═══════════════════════════════════════════════════════════════════════════

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  plan      String   @default("standard")
  branding  Json     @default("{}")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  departments  Department[]
  members      OrganizationMember[]
  config       TenantConfig?
  assessments  Assessment[]
  questions    AssessQuestion[]
  deployments  AssessmentDeployment[]
  mediaAssets  MediaAsset[]
  collections  AssessQuestionCollection[]

  @@index([slug])
}

model Department {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  name           String
  code           String?
  parentId       String? @map("parent_id")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Department?          @relation("DeptTree", fields: [parentId], references: [id])
  children     Department[]         @relation("DeptTree")
  members      OrganizationMember[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  departmentId   String?  @map("department_id")
  role           String   @default("student")
  employeeId     String?  @map("employee_id")
  joinedAt       DateTime @default(now()) @map("joined_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([departmentId])
}

model TenantConfig {
  id             String @id @default(cuid())
  organizationId String @unique @map("organization_id")
  scoringRules   Json   @default("{}") @map("scoring_rules")
  xpRules        Json   @default("{}") @map("xp_rules")
  badgeOverrides Json   @default("[]") @map("badge_overrides")
  certTemplates  Json   @default("[]") @map("cert_templates")
  featureFlags   Json   @default("{}") @map("feature_flags")
  rules          Json   @default("[]")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Assessment {
  id                 String    @id @default(cuid())
  organizationId     String?   @map("organization_id")
  authorId           String    @map("author_id")
  kind               String    @default("formative")
  lifecycle          String    @default("draft")
  title              String
  description        String?
  subject            String?
  visibility         String    @default("private")
  totalMarks         Int       @default(0) @map("total_marks")
  metadata           Json      @default("{}")
  pinned             Boolean   @default(false)
  favorited          Boolean   @default(false)
  archivedAt         DateTime? @map("archived_at")
  publishedVersionId String?   @unique @map("published_version_id")
  legacyQuizId       String?   @unique @map("legacy_quiz_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization     Organization?      @relation(fields: [organizationId], references: [id])
  author           User               @relation("AssessmentAuthor", fields: [authorId], references: [id])
  publishedVersion AssessmentVersion? @relation("PublishedAssessmentVersion", fields: [publishedVersionId], references: [id])
  versions         AssessmentVersion[] @relation("AssessmentVersions")
  sections         AssessmentSection[]
  deployments      AssessmentDeployment[]

  @@index([authorId])
  @@index([organizationId])
  @@index([lifecycle])
  @@index([kind])
  @@index([legacyQuizId])
}

model AssessmentVersion {
  id            String    @id @default(cuid())
  assessmentId  String    @map("assessment_id")
  version       Int
  snapshot      Json
  changeLog     String?   @map("change_log")
  createdById   String    @map("created_by_id")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  assessment   Assessment  @relation("AssessmentVersions", fields: [assessmentId], references: [id], onDelete: Cascade)
  publishedFor Assessment? @relation("PublishedAssessmentVersion")
  createdBy    User        @relation("AssessmentVersionCreator", fields: [createdById], references: [id])
  deployments  AssessmentDeployment[]
  attempts     AssessmentAttempt[]

  @@unique([assessmentId, version])
  @@index([assessmentId])
}

model AssessmentSection {
  id           String @id @default(cuid())
  assessmentId String @map("assessment_id")
  title        String?
  order        Int    @default(0)
  metadata     Json   @default("{}")

  assessment Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  items      AssessmentItem[]

  @@index([assessmentId, order])
}

model AssessmentItem {
  id           String  @id @default(cuid())
  sectionId    String  @map("section_id")
  questionId   String  @map("question_id")
  order        Int     @default(0)
  marks        Int     @default(1)
  required     Boolean @default(true)
  metadata     Json    @default("{}")

  section  AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question AssessQuestion @relation(fields: [questionId], references: [id])

  @@unique([sectionId, questionId])
  @@index([sectionId, order])
}

model AssessQuestionType {
  id          String  @id @default(cuid())
  slug        String  @unique
  label       String
  category    String
  schema      Json    @default("{}")
  graderKey   String  @map("grader_key")
  rendererKey String  @map("renderer_key")
  enabled     Boolean @default(true)

  questions AssessQuestion[]
}

model AssessQuestion {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  departmentId   String?  @map("department_id")
  authorId       String   @map("author_id")
  typeId         String   @map("type_id")
  stem           String   @db.Text
  subject        String?
  courseId       String?  @map("course_id")
  unit           String?
  chapter        String?
  topic          String?
  subtopic       String?
  learningOutcome String? @map("learning_outcome")
  difficulty     String?
  bloomLevel     String?  @map("bloom_level")
  estimatedSecs  Int?     @map("estimated_seconds")
  marks          Int      @default(1)
  negativeMarks  Float?   @map("negative_marks")
  explanation    String?  @db.Text
  hints          Json     @default("[]")
  metadata       Json     @default("{}")
  tags           Json     @default("[]")
  concepts       Json     @default("[]")
  keywords       Json     @default("[]")
  aliases        Json     @default("[]")
  placementTags  Json     @default("[]") @map("placement_tags")
  companyTags    Json     @default("[]") @map("company_tags")
  skillTags      Json     @default("[]") @map("skill_tags")
  visibility     String   @default("private")
  permissionMode String   @default("owner_only") @map("permission_mode")
  language       String   @default("en")
  status         String   @default("draft")
  version        Int      @default(1)
  aiGenerated    Boolean  @default(false) @map("ai_generated")
  aiConfidence   Float?   @map("ai_confidence")
  aiHistoryId    String?  @map("ai_history_id")
  forkedFromId   String?  @map("forked_from_id")
  searchText     String?  @db.Text @map("search_text")
  legacyBankId   String?  @unique @map("legacy_bank_id")
  legacyQuizQId  String?  @unique @map("legacy_quiz_q_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization?    @relation(fields: [organizationId], references: [id])
  author          User             @relation("QuestionAuthor", fields: [authorId], references: [id])
  type            AssessQuestionType     @relation(fields: [typeId], references: [id])
  forkedFrom      AssessQuestion?  @relation("QuestionFork", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks           AssessQuestion[] @relation("QuestionFork")
  versions        AssessQuestionVersion[]
  choices         AssessChoice[]
  mediaUsages     MediaUsage[]
  assessmentItems AssessmentItem[]
  attemptQuestions AssessmentAttemptQuestion[]
  responses       AssessmentResponse[]
  analytics       AssessQuestionAnalytics?
  parentRelations AssessQuestionRelation[] @relation("ChildQuestion")
  childRelations  AssessQuestionRelation[] @relation("ParentQuestion")
  collectionItems AssessQuestionCollectionItem[]

  @@index([authorId])
  @@index([typeId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([subject])
  @@index([topic])
  @@index([difficulty])
  @@index([bloomLevel])
  @@index([visibility])
  @@index([status])
  @@index([legacyBankId])
  @@index([legacyQuizQId])
}

model AssessQuestionVersion {
  id          String   @id @default(cuid())
  questionId  String   @map("question_id")
  version     Int
  snapshot    Json
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  question  AssessQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdBy User     @relation("QuestionVersionCreator", fields: [createdById], references: [id])
  attemptQuestions AssessmentAttemptQuestion[]
  responses AssessmentResponse[]
  mediaUsages MediaUsage[]

  @@unique([questionId, version])
  @@index([questionId])
}

model AssessChoice {
  id         String  @id @default(cuid())
  questionId String  @map("question_id")
  text       String  @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")
  order      Int     @default(0)
  metadata   Json    @default("{}")

  question AssessQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, order])
}

model MediaAsset {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  uploaderId     String   @map("uploader_id")
  mimeType       String   @map("mime_type")
  assetType      String   @map("asset_type")
  originalName   String   @map("original_name")
  storageKey     String   @map("storage_key")
  sizeBytes      Int      @map("size_bytes")
  checksum       String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  uploader     User          @relation("MediaUploader", fields: [uploaderId], references: [id])
  variants     MediaVariant[]
  usages       MediaUsage[]

  @@index([uploaderId])
  @@index([organizationId])
}

model MediaVariant {
  id         String  @id @default(cuid())
  assetId    String  @map("asset_id")
  variant    String
  storageKey String  @map("storage_key")
  width      Int?
  height     Int?
  url        String?

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

model MediaUsage {
  id                String  @id @default(cuid())
  assetId           String  @map("asset_id")
  entityType        String  @map("entity_type")
  entityId          String  @map("entity_id")
  role              String
  questionId        String? @map("question_id")
  questionVersionId String? @map("question_version_id")

  asset           MediaAsset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  question        AssessQuestion?       @relation(fields: [questionId], references: [id], onDelete: SetNull)
  questionVersion AssessQuestionVersion? @relation(fields: [questionVersionId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([questionId])
  @@index([questionVersionId])
}

model AssessmentDeployment {
  id             String    @id @default(cuid())
  organizationId String?   @map("organization_id")
  assessmentId   String    @map("assessment_id")
  versionId      String    @map("version_id")
  mode           String
  title          String
  hostId         String?   @map("host_id")
  contextType    String?   @map("context_type")
  contextId      String?   @map("context_id")
  settings       Json      @default("{}")
  status         String    @default("draft")
  scheduledAt    DateTime? @map("scheduled_at")
  dueAt          DateTime? @map("due_at")
  legacySessionId String?  @unique @map("legacy_session_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization?     @relation(fields: [organizationId], references: [id])
  assessment   Assessment        @relation(fields: [assessmentId], references: [id])
  version      AssessmentVersion @relation(fields: [versionId], references: [id])
  host         User?             @relation("DeploymentHost", fields: [hostId], references: [id])
  attempts     AssessmentAttempt[]
  liveRoom     AssessLiveRoom?
  homework     HomeworkAssignment?
  assignment   CourseAssignment?

  @@index([assessmentId])
  @@index([mode])
  @@index([status])
  @@index([contextType, contextId])
  @@index([hostId])
  @@index([legacySessionId])
}

model AssessmentAttempt {
  id                  String    @id @default(cuid())
  deploymentId        String    @map("deployment_id")
  assessmentVersionId String    @map("assessment_version_id")
  userId              String    @map("user_id")
  mode                String
  status              String    @default("in_progress")
  reconnectToken      String?   @unique @map("reconnect_token")
  shuffleSeed         String?   @map("shuffle_seed")
  startedAt           DateTime  @default(now()) @map("started_at")
  submittedAt         DateTime? @map("submitted_at")
  gradedAt            DateTime? @map("graded_at")
  metadata            Json      @default("{}")

  deployment       AssessmentDeployment @relation(fields: [deploymentId], references: [id])
  assessmentVersion AssessmentVersion   @relation(fields: [assessmentVersionId], references: [id])
  user             User                  @relation(fields: [userId], references: [id])
  learningRecord   LearningRecord?
  engagementRecord EngagementRecord?
  attemptQuestions AssessmentAttemptQuestion[]
  participant      AssessParticipant?

  @@index([deploymentId])
  @@index([userId])
  @@index([userId, deploymentId])
  @@index([status])
}

model AssessmentAttemptQuestion {
  id                String @id @default(cuid())
  attemptId         String @map("attempt_id")
  questionId        String @map("question_id")
  questionVersionId String @map("question_version_id")
  order             Int
  marks             Int    @default(1)
  status            String @default("pending")

  attempt         AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        AssessQuestion           @relation(fields: [questionId], references: [id])
  questionVersion AssessQuestionVersion    @relation(fields: [questionVersionId], references: [id])
  response        AssessmentResponse?

  @@unique([attemptId, questionId])
  @@index([attemptId, order])
}

model AssessmentResponse {
  id                String    @id @default(cuid())
  attemptQuestionId String    @unique @map("attempt_question_id")
  questionId        String    @map("question_id")
  questionVersionId String    @map("question_version_id")
  participantId     String?   @map("participant_id")
  answer            Json
  isCorrect         Boolean?  @map("is_correct")
  marksAwarded      Float?    @map("marks_awarded")
  responseTimeMs    Int?      @map("response_time_ms")
  gradedBy          String?   @map("graded_by")
  gradedAt          DateTime? @map("graded_at")
  feedback          String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")

  attemptQuestion AssessmentAttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)
  question        AssessQuestion           @relation(fields: [questionId], references: [id])
  questionVersion AssessQuestionVersion    @relation(fields: [questionVersionId], references: [id])
  participant     AssessParticipant?        @relation(fields: [participantId], references: [id])

  @@index([questionId])
  @@index([participantId])
}

model LearningRecord {
  id               String   @id @default(cuid())
  attemptId        String   @unique @map("attempt_id")
  accuracy         Float
  marksEarned      Float    @map("marks_earned")
  totalMarks       Int      @map("total_marks")
  correctCount     Int      @default(0) @map("correct_count")
  wrongCount       Int      @default(0) @map("wrong_count")
  skippedCount     Int      @default(0) @map("skipped_count")
  topicMastery     Json     @default("{}") @map("topic_mastery")
  bloomBreakdown   Json     @default("{}") @map("bloom_breakdown")
  difficultySolved Json     @default("{}") @map("difficulty_solved")
  weakConcepts     Json     @default("[]") @map("weak_concepts")
  strongConcepts   Json     @default("[]") @map("strong_concepts")
  timePerConcept   Json     @default("{}") @map("time_per_concept")
  computedAt       DateTime @default(now()) @map("computed_at")

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model EngagementRecord {
  id                String   @id @default(cuid())
  attemptId         String   @unique @map("attempt_id")
  xpEarned          Int      @default(0) @map("xp_earned")
  coinsEarned       Int      @default(0) @map("coins_earned")
  streak            Int      @default(0)
  combo             Int      @default(0)
  sessionRank       Int?     @map("session_rank")
  achievementPoints Int      @default(0) @map("achievement_points")
  powerUpsUsed      Json     @default("[]") @map("power_ups_used")
  sessionScore      Float    @default(0) @map("session_score")
  computedAt        DateTime @default(now()) @map("computed_at")

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model AssessLiveRoom {
  id                   String    @id @default(cuid())
  deploymentId         String    @unique @map("deployment_id")
  roomCode             String?   @unique @map("room_code")
  pin                  String?
  status               String    @default("lobby")
  currentQuestionIndex Int     @default(-1) @map("current_question_index")
  questionStartedAt    DateTime? @map("question_started_at")
  startedAt            DateTime? @map("started_at")
  endedAt              DateTime? @map("ended_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  deployment   AssessmentDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  participants AssessParticipant[]
  snapshots    AssessLeaderboardSnapshot[]
  analytics    AssessLiveRoomAnalytics?
}

model AssessParticipant {
  id              String   @id @default(cuid())
  roomId          String   @map("room_id")
  userId          String?  @map("user_id")
  attemptId       String?  @unique @map("attempt_id")
  displayName     String   @map("display_name")
  avatar          String?
  teamId          String?  @map("team_id")
  status          String   @default("online")
  engagementScore Float    @default(0) @map("engagement_score")
  learningCorrect Int      @default(0) @map("learning_correct")
  learningWrong   Int      @default(0) @map("learning_wrong")
  streak          Int      @default(0)
  joinedAt        DateTime @default(now()) @map("joined_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")

  room      AssessLiveRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  attempt   AssessmentAttempt?   @relation(fields: [attemptId], references: [id])
  responses AssessmentResponse[]
  team      AssessTeam?          @relation(fields: [teamId], references: [id])

  @@unique([roomId, userId])
  @@index([roomId, engagementScore])
}

model AssessTeam {
  id     String @id @default(cuid())
  roomId String @map("room_id")
  name   String
  color  String?
  score  Float  @default(0)

  participants AssessParticipant[]
}

model AssessLeaderboardSnapshot {
  id            String   @id @default(cuid())
  roomId        String?  @map("room_id")
  scopeType     String?  @map("scope_type")
  scopeId       String?  @map("scope_id")
  period        String?
  questionIndex Int?     @map("question_index")
  rankings      Json
  capturedAt    DateTime @default(now()) @map("captured_at")

  room AssessLiveRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, questionIndex])
}

model AssessLiveRoomAnalytics {
  id                String @id @default(cuid())
  roomId            String @unique @map("room_id")
  totalParticipants Int    @default(0) @map("total_participants")
  avgAccuracy       Float  @default(0) @map("avg_accuracy")
  avgResponseTimeMs Int?   @map("avg_response_time_ms")
  questionStats     Json   @default("[]") @map("question_stats")

  room AssessLiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model HomeworkAssignment {
  id           String   @id @default(cuid())
  deploymentId String   @unique @map("deployment_id")
  dueAt        DateTime @map("due_at")
  allowLate    Boolean  @default(false) @map("allow_late")
  maxAttempts  Int      @default(1) @map("max_attempts")
  createdAt    DateTime @default(now()) @map("created_at")

  deployment AssessmentDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}

model CourseAssignment {
  id              String  @id @default(cuid())
  deploymentId    String  @unique @map("deployment_id")
  courseId        String? @map("course_id")
  lectureId       String? @map("lecture_id")
  weightPercent   Float?  @map("weight_percent")
  syncToGradebook Boolean @default(true) @map("sync_to_gradebook")

  deployment AssessmentDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}

model AssessQuestionAnalytics {
  id                  String    @id @default(cuid())
  questionId          String    @unique @map("question_id")
  timesUsed           Int       @default(0) @map("times_used")
  attempts            Int       @default(0)
  correctCount        Int       @default(0) @map("correct_count")
  skipCount           Int       @default(0) @map("skip_count")
  avgTimeMs           Int?      @map("avg_time_ms")
  avgAccuracy         Float     @default(0) @map("avg_accuracy")
  discriminationIdx   Float?    @map("discrimination_index")
  pValue              Float?    @map("p_value")
  confusionScore      Float?    @map("confusion_score")
  skipRate            Float     @default(0) @map("skip_rate")
  guessRate           Float?    @map("guess_rate")
  popularity          Float     @default(0)
  healthScore         Float?    @map("health_score")
  facultyRating       Float?    @map("faculty_rating")
  studentRating       Float?    @map("student_rating")
  aiSuggestedRevision Json?     @map("ai_suggested_revision")
  lastUsedAt          DateTime? @map("last_used_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  question AssessQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AssessQuestionRelation {
  id               String @id @default(cuid())
  parentQuestionId String @map("parent_question_id")
  childQuestionId  String @map("child_question_id")
  relationType     String @map("relation_type")
  order            Int    @default(0)
  metadata         Json   @default("{}")

  parent AssessQuestion @relation("ParentQuestion", fields: [parentQuestionId], references: [id], onDelete: Cascade)
  child  AssessQuestion @relation("ChildQuestion", fields: [childQuestionId], references: [id], onDelete: Cascade)

  @@unique([parentQuestionId, childQuestionId, relationType])
  @@index([parentQuestionId])
  @@index([childQuestionId])
}

model AssessQuestionCollection {
  id             String   @id @default(cuid())
  authorId       String   @map("author_id")
  organizationId String?  @map("organization_id")
  departmentId   String?  @map("department_id")
  name           String
  description    String?
  kind           String   @default("folder")
  visibility     String   @default("private")
  smartRules     Json?    @map("smart_rules")
  isTemplate     Boolean  @default(false) @map("is_template")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  author       User                           @relation("QuestionCollectionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  organization Organization?                  @relation(fields: [organizationId], references: [id])
  items        AssessQuestionCollectionItem[]

  @@index([authorId])
  @@index([organizationId])
  @@index([kind])
  @@index([visibility])
}

model AssessQuestionCollectionItem {
  id           String   @id @default(cuid())
  collectionId String   @map("collection_id")
  questionId   String   @map("question_id")
  order        Int      @default(0)
  addedAt      DateTime @default(now()) @map("added_at")

  collection AssessQuestionCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  question   AssessQuestion           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, questionId])
  @@index([collectionId])
  @@index([questionId])
}

// ─── Gamification (platform-wide) ──────────────────────────────────────────

model UserGamificationProfile {
  userId         String   @id @map("user_id")
  organizationId String?  @map("organization_id")
  totalXp        Int      @default(0) @map("total_xp")
  level          Int      @default(1)
  coins          Int      @default(0)
  currentStreak  Int      @default(0) @map("current_streak")
  bestStreak     Int      @default(0) @map("best_streak")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model XPTransaction {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  amount    Int
  source    String
  sourceId  String?  @map("source_id")
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  amount    Int
  source    String
  sourceId  String?  @map("source_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model BadgeDefinition {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  category    String
  rarity      String @default("common")
  icon        String
  criteria    Json
  xpReward    Int    @default(0) @map("xp_reward")
  coinReward  Int    @default(0) @map("coin_reward")
  enabled     Boolean @default(true)

  awards BadgeAward[]
}

model BadgeAward {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  badgeId  String   @map("badge_id")
  source   String
  sourceId String?  @map("source_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge BadgeDefinition @relation(fields: [badgeId], references: [id])

  @@index([userId, earnedAt])
}

model AchievementDefinition {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  tiers    Json   @default("[]")
  criteria Json
  enabled  Boolean @default(true)

  achievements Achievement[]
}

model Achievement {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  definitionId String    @map("definition_id")
  tier         Int       @default(1)
  progress     Float     @default(0)
  unlockedAt   DateTime? @map("unlocked_at")

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  definition AchievementDefinition @relation(fields: [definitionId], references: [id])

  @@unique([userId, definitionId])
}

// ─── Analytics, AI, Audit ────────────────────────────────────────────────────

model PlatformAnalyticsEvent {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  eventType      String   @map("event_type")
  actorId        String?  @map("actor_id")
  assessmentId   String?  @map("assessment_id")
  questionId     String?  @map("question_id")
  deploymentId   String?  @map("deployment_id")
  attemptId      String?  @map("attempt_id")
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  actor User? @relation("AnalyticsActor", fields: [actorId], references: [id])

  @@index([eventType, createdAt])
  @@index([organizationId, createdAt])
  @@index([assessmentId])
  @@index([actorId, createdAt])
}

model AIHistory {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  feature      String
  model        String?
  provider     String?
  prompt       String    @db.Text
  promptHash   String    @map("prompt_hash")
  temperature  Float?
  input        Json
  output       Json?
  confidence   Float?
  entityType   String?   @map("entity_type")
  entityId     String?   @map("entity_id")
  editedById   String?   @map("edited_by_id")
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  tokens       Int?
  latencyMs    Int?      @map("latency_ms")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model PlatformAuditLog {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  actorId        String   @map("actor_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  actor User @relation("PlatformAuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([organizationId, createdAt])
}

model MusicTrack {
  id         String   @id @default(cuid())
  filename   String
  duration   Float
  size       Int      @map("size_bytes")
  mimeType   String   @map("mime_type")
  uploaderId String   @map("uploader_id")
  uploadDate DateTime @default(now()) @map("upload_date")
  checksum   String?
  storageKey String   @map("storage_key")

  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
}

// Interactive Classroom Studio Models
model Presentation {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  sourceType  String   @map("source_type") // powerpoint, google_slides, pdf, manual
  sourceUrl   String?  @map("source_url")
  thumbnail   String?
  status      String   @default("draft") // draft, ready, archived
  instructorId String   @map("instructor_id")
  courseId    String?  @map("course_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  instructor    User               @relation("PresentationAuthor", fields: [instructorId], references: [id], onDelete: Cascade)
  course        Course?            @relation(fields: [courseId], references: [id])
  slides        Slide[]
  sessions      ClassroomSession[]

  @@index([instructorId])
  @@index([courseId])
  @@index([status])
}

model Slide {
  id             String   @id @default(cuid())
  presentationId String   @map("presentation_id")
  order          Int
  title          String
  content        Json?    // Rich content, images, etc.
  thumbnail      String?
  notes          String?  @db.Text
  isLocked       Boolean  @default(false) @map("is_locked")
  isHidden       Boolean  @default(false) @map("is_hidden")
  isImportant    Boolean  @default(false) @map("is_important")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  presentation Presentation   @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  interactions Interaction[]

  @@index([presentationId])
  @@index([order])
  @@unique([presentationId, order])
}

model Interaction {
  id          String   @id @default(cuid())
  slideId     String   @map("slide_id")
  type        String   // poll, mcq, multiple_select, true_false, word_cloud, open_answer, quiz, rating, reaction, emoji_voting, code_challenge, image_annotation, drawing, file_upload, discussion, attendance_check, exit_ticket, reflection, ai_question
  title       String?  // Display title (optional — slide content is the source of truth)
  question    String?  // Question text (optional — derived from slide if not set)
  options     Json?    // Option array: [{text: string, isCorrect?: boolean}]
  settings    Json?    // Interaction-specific settings (timer, anonymous, multipleSelection, required, etc.)
  duration    Int?     // Seconds
  points      Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  slide      Slide                 @relation(fields: [slideId], references: [id], onDelete: Cascade)
  responses  InteractionResponse[]

  @@index([slideId])
  @@index([type])
}

model ClassroomSession {
  id             String   @id @default(cuid())
  presentationId String   @map("presentation_id")
  instructorId   String   @map("instructor_id")
  title          String?
  roomCode       String   @unique @map("room_code")
  status         String   @default("scheduled") // scheduled, active, completed, cancelled
  scheduledAt    DateTime? @map("scheduled_at")
  startedAt      DateTime? @map("started_at")
  endedAt        DateTime? @map("ended_at")
  currentSlideId String?  @map("current_slide_id")
  activeInteractionId String? @map("active_interaction_id")
  settings       Json?    // Session settings
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  presentation   Presentation            @relation(fields: [presentationId], references: [id])
  instructor     User                    @relation("ClassroomSessionHost", fields: [instructorId], references: [id], onDelete: Cascade)
  participants      ClassroomParticipant[]
  analytics         ClassroomSessionAnalytics?
  responses         InteractionResponse[]
  studentQuestions  StudentQuestion[]
  chatMessages      StudentChatMessage[]

  @@index([instructorId])
  @@index([presentationId])
  @@index([roomCode])
  @@index([status])
}

model ClassroomParticipant {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  userId      String   @map("user_id")
  joinedAt    DateTime @default(now()) @map("joined_at")
  lastSeenAt  DateTime? @map("last_seen_at")
  status      String   @default("online") // online, offline, left
  device      String?
  browser     String?
  raisedHand  Boolean  @default(false) @map("raised_hand")

  session   ClassroomSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses InteractionResponse[]

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model InteractionResponse {
  id             String   @id @default(cuid())
  sessionId      String   @map("session_id")
  interactionId  String   @map("interaction_id")
  participantId  String   @map("participant_id")
  response       Json
  duration       Int?     // Response time in seconds
  submittedAt    DateTime @default(now()) @map("submitted_at")
  isCorrect      Boolean? @map("is_correct")
  pointsAwarded  Int?     @map("points_awarded")

  session     ClassroomSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  interaction Interaction          @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  participant ClassroomParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([interactionId])
  @@index([participantId])
}

model ClassroomSessionAnalytics {
  id                   String   @id @default(cuid())
  sessionId            String   @unique @map("session_id")
  totalParticipants    Int      @map("total_participants")
  activeParticipants   Int      @map("active_participants")
  totalResponses       Int      @map("total_responses")
  averageResponseTime  Float?   @map("average_response_time")
  participationRate    Float?   @map("participation_rate")
  accuracyRate         Float?   @map("accuracy_rate")
  engagementScore      Float?   @map("engagement_score")
  mostEngagedSlide     String?  @map("most_engaged_slide")
  leastEngagedSlide    String?  @map("least_engaged_slide")
  data                 Json?    // Detailed analytics data
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  session ClassroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model StudentQuestion {
  id         String   @id @default(cuid())
  sessionId  String   @map("session_id")
  userId     String   @map("user_id")
  text       String
  isResolved Boolean  @default(false) @map("is_resolved")
  isPinned   Boolean  @default(false) @map("is_pinned")
  createdAt  DateTime @default(now()) @map("created_at")

  session ClassroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
}

model StudentChatMessage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  userId    String   @map("user_id")
  message   String
  role      String   @default("student") // student | instructor
  createdAt DateTime @default(now()) @map("created_at")

  session ClassroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
}
