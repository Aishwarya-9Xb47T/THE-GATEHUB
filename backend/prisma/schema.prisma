  @@index([userId, learningUniverseId, publishVersionId])
  @@index([lessonId])
}

model LearningUniverseCertificate {
  id                  String                    @id @default(cuid())
  certificateId       String                    @unique @map("certificate_id")
  userId              String                    @map("user_id")
  learningUniverseId  String                    @map("learning_universe_id")
  publishVersionId    String?                   @map("publish_version_id")
  certificateTitle    String?                   @map("certificate_title")
  certificateBody     String?                   @map("certificate_body")
  issuedAt            DateTime                  @default(now()) @map("issued_at")
  completionDate      DateTime?                 @map("completion_date")
  url                 String?
  pdfPath             String?                   @map("pdf_path")
  verificationUrl     String?                   @map("verification_url")
  status              String                    @default("active")
