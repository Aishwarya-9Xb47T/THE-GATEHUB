// Learning Platform Models - W3Schools-style
model ResourceCourse {
  id          String   @id @default(cuid())
  title       String
  description String?
  thumbnail   String?
  instructorId String  @map("instructor_id")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  content     ResourceContent?
  instructor  User     @relation("ResourceCourses", fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId])
  @@index([createdAt])
  @@index([published])
}

model ResourceContent {
  id                String   @id @default(cuid())
  courseId          String   @unique @map("course_id")
  latexContent      String   @map("latex_content")
  compiledHtml      String   @map("compiled_html")
  structuredContent Json?    @map("structured_content")
  projectFiles      Json?    @map("project_files")
  assets            Json?    @map("assets")
  pdfUrl            String?  @map("pdf_url")
  updatedAt         DateTime @updatedAt @map("updated_at")
  course            ResourceCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([updatedAt])
