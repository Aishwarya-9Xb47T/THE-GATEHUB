model Lecture {
  id           String            @id @default(cuid())
  title        String
  type         String            @default("video")
  content      String?
  videoUrl     String?           @map("video_url")
  videoType    String?           @map("video_type") // "youtube" or "upload"
  videoCaptions Json?            @map("video_captions") // [{ language, label, url, default? }]
  notesPdfUrl  String?           @map("notes_pdf_url")
  compiledPdfUrl String?         @map("compiled_pdf_url")
  duration     Int?
  order        Int               @default(0)
  sectionId    String            @map("section_id")
  quizId       String?           @map("quiz_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
