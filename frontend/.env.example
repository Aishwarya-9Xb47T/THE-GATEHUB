# Local development: the Vite `/api` proxy is used by the API client (getApiBase → "/api").
# These values are for tools that talk to the backend origin directly.
VITE_API_BASE_URL=http://localhost:5000/api
VITE_WS_BASE_URL=ws://localhost:5000
# Optional Yjs override (leave unset locally so Vite `/yjs` proxy is used)
# VITE_WS_URL=ws://localhost:5000/yjs/

# Production values live in `.env.production` (Render backend):
#   VITE_API_BASE_URL=https://gatehub-backend-mprr.onrender.com/api
# Override locally without committing via `.env.production.local`.

# Public app origin for cross-device QR / share links (LAN or production).
# Example LAN: VITE_PUBLIC_APP_URL=http://192.168.1.25:5173
# Example prod: VITE_PUBLIC_APP_URL=https://thegatehub.com
# Do NOT commit a personal IP. Required when sharing QR from localhost to phones.
# VITE_PUBLIC_APP_URL=
